<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/result_bg" android:layoutDirection="rtl">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:orientation="vertical">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="חיבור לסוכן" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="כשהתוצאה היא לא ידוע, צילום אזור הברקוד ופרטי המוצר יישלחו לבדיקה נוספת. בהקלדה ידנית לא נשלח צילום. מידע מאומת יחזור לאפליקציה." android:textColor="#CCCCCC" android:textSize="14sp" />
  <EditText android:id="@+id/agentUrl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:hint="כתובת השירות" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" android:inputType="textUri" android:textDirection="ltr" android:singleLine="true" android:importantForAutofill="no" />
  <EditText android:id="@+id/agentToken" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="קוד חיבור" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" android:inputType="textPassword" android:singleLine="true" android:textDirection="ltr" android:importantForAutofill="no" />
  <TextView android:id="@+id/agentSettingsError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFB0B0" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
  <com.google.android.material.button.MaterialButton android:id="@+id/agentSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="חיבור ושליחת בדיקות" android:textColor="#111111" android:backgroundTint="#FFFFFF" />
  <com.google.android.material.button.MaterialButton android:id="@+id/agentDisconnect" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ניתוק והפסקת שליחה" android:textColor="#FFFFFF" />
  <com.google.android.material.button.MaterialButton android:id="@+id/agentCancel" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ביטול" android:textColor="#FFFFFF" />
 </LinearLayout>
</ScrollView>
