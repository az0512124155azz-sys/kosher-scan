{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kosher-scan-agent",
  "main": "src/worker.mjs",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-07-30",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/telegram/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "kosher-scan-agent", "database_id": "5374d8e1-d493-4625-b01c-eed50ca0ab54", "migrations_dir": "migrations"}],
  "triggers": {"crons": ["* * * * *"]},
  "vars": {"GEMINI_MODEL": "gemini-2.5-flash", "DAILY_AI_LIMIT": "100", "PHOTO_RETENTION_DAYS": "30"},
  "observability": {"enabled": false}
}
